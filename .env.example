# Copy this file to .env.local and fill in the values. Never commit .env.local.
# All variables are read through src/lib/env.ts (public) and src/lib/env.server.ts (server only).

# Site URL without a trailing slash: canonical URLs, hreflang, sitemap and Open Graph (server only).
# Optional; defaults to https://berkcertel.com.
SITE_URL=https://berkcertel.com

# --- Contact form mail (Nodemailer over Gmail SMTP) ---

# SMTP server host. Optional; defaults to smtp.gmail.com.
SMTP_HOST=smtp.gmail.com

# SMTP port. Optional; defaults to 465 (SSL).
SMTP_PORT=465

# Use SSL/TLS from the start ("true" for port 465). Optional; defaults to true.
SMTP_SECURE=true

# Gmail address that sends the contact mails. Required to send mail.
SMTP_USER=

# Google App password for SMTP_USER (Google Account → Security → 2-Step Verification → App passwords).
# Required to send mail.
SMTP_PASS=

# Inbox that receives the contact form messages. Required to send mail.
CONTACT_TO_EMAIL=

# --- Cloudflare Turnstile (spam check on the contact form) ---
# For local development, Cloudflare's test keys always pass:
#   site key   1x00000000000000000000AA
#   secret key 1x0000000000000000000000000000000AA

# Public site key for the widget. Without it the widget is not shown and the form cannot be sent.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret key for the server-side check. Required to send mail.
TURNSTILE_SECRET_KEY=

# --- Google Search Console ---

# "content" value of the HTML-tag verification method. Optional.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
