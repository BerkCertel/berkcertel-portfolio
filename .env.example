# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Public site URL (no trailing slash). Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://berkcertel.com

# --- Contact form mail (Gmail SMTP via Nodemailer) ---
# SMTP_USER = the Gmail address that sends the mail.
# SMTP_PASS = a Google "App password" (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Where contact form messages are delivered
CONTACT_TO_EMAIL=

# --- Cloudflare Turnstile ---
# Local development can use Cloudflare's test keys (always pass):
#   site key   1x00000000000000000000AA
#   secret key 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Google Search Console (optional, add later) ---
# The "content" value of the HTML-tag verification method.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
